{
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite": {}
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "desktop"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vsliveshare.vsliveshare",
        "ms-python.python",
        "vsls-contrib.gitdoc"
      ],
      "settings": {
        "gitdoc.enabled": true,
        "git.autofetch": true,
        "gitdoc.autoCommitDelay": 5000
      }
    }
  }
}
